# Copy to .env, fill in, then: source .env && python3 server.py
# Everything is optional: without DIAL_API_KEY every call is simulated.

# Dial (outbound AI voice calls)
export DIAL_API_KEY=
export DIAL_NUMBER=            # Dial's from-number, e.g. +1...
# Demo only: the single number Dial may call (use your own phone). Never commit the real one.
export HOMEBY4_DEMO_PHONE=

# Structured extraction + triage LLM (OpenAI-compatible endpoint, e.g. Azure OpenAI .../openai/v1)
export LLM_BASE_URL=
export LLM_API_KEY=
export LLM_MODEL=

# Keewano (event logging + natural-language questions over call history)
export KEEWANO_TOKEN=

# Optional
# export HOMEBY4_ENGINE=dp             # solver engine: bnb (default) | dp
# export HOMEBY4_CALENDAR_SYNC=1       # write the solved week into macOS Calendar.app
# export HOMEBY4_CALENDAR=Privat       # which calendar
# export HOMEBY4_EMAIL_MCP="npx -y @gongrzhe/server-gmail-autoauth-mcp"   # email context for triage
# export HOMEBY4_HOME="<your home address, city>"   # real home for drive times + sunset; geocoded once, cached in data/home.json (gitignored). Unset => placeholder home
# export HOMEBY4_HOME_LABEL=Home                    # how home is named in the UI
